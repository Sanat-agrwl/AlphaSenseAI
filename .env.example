# AlphaSense AI — Environment Variables
# Copy to .env and fill in. Never commit .env to git.

# ── Zerodha Kite (optional, only for live NSE trading) ───────────────────────
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
EXECUTION_MODE=paper       # paper | live

# ── Interactive Brokers (paper trading via IB Gateway) ───────────────────────
# Step 1: Download IB Gateway from interactivebrokers.com
# Step 2: Log in with paper account credentials
# Step 3: Enable API: File → Global Config → API → Settings → port 4002
# Step 4: Set IBKR_ENABLED=true below
IBKR_ENABLED=false         # set to true once IB Gateway is running
IBKR_HOST=127.0.0.1        # localhost (or SSH tunnel host)
IBKR_PORT=4002             # 4002=paper, 4001=live (NEVER 4001 until ready)
IBKR_CLIENT_ID=1

# ── AI / Sentiment models ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # enables Claude in ensemble scorer
OPENAI_API_KEY=             # enables GPT-4o in ensemble scorer
HF_TOKEN=                   # higher rate limits for HuggingFace (optional)

# ── Capital ───────────────────────────────────────────────────────────────────
INITIAL_CAPITAL=10000000   # ₹1 Cr